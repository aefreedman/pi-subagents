{
  "name": "@aefree/pi-subagents",
  "version": "0.8.1",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "agents/",
    "extensions/",
    "skills/",
    "src/",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "npx --yes tsx tests/using-subagents-skill.test.ts && npx --yes tsx tests/agent-discovery.test.ts && npx --yes tsx tests/package-agent-registry.test.ts && npx --yes tsx tests/execution-profile.test.ts && npx --yes tsx tests/project-agent-trust.test.ts && npx --yes tsx tests/child-extensions.test.ts && npx --yes tsx tests/child-resources.test.ts && npx --yes tsx tests/child-process.test.ts && npx --yes tsx tests/pi-launcher.test.ts && npx --yes tsx tests/packed-package.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@aefree/pi-capability-registry": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "description": "Pi tools and package support for subagent orchestration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aefreedman/pi-subagents.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/aefreedman/pi-subagents/issues"
  },
  "homepage": "https://github.com/aefreedman/pi-subagents#readme",
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
